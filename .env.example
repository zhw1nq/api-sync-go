# ==============================================================================
# api-sync-go — Environment Variables Template
# Copy this file to .env and fill in values
# ==============================================================================

# API Keys (comma-separated, rotate without downtime)
API_KEYS=change-me-key-1,change-me-key-2

# Allowed Domain (bắt buộc, ví dụ: localhost:3000 hoặc domain web - NO fallback)
ALLOWED_DOMAIN=localhost:3000

# MariaDB (same database as 7gc-portal, READ-ONLY)
DATABASE_URL=mysql://user:password@localhost:3306/7c_portal

# Redis (nếu pass có ký tự @ thì mã hóa thành %40)
REDIS_URL=redis://:password@localhost:6379

# Cache TTL
USER_CACHE_TTL=5m
NEGATIVE_CACHE_TTL=1m
AVATAR_CACHE_TTL=30m

# Rate Limit (theo X-API-KEY — tất cả server dùng chung 1 key chia sẻ quota)
# Burst ~90 req/đợt từ CS2: 300 req / 5s cho phép ~3 đợt bulk dồn dập mỗi 5 giây
RATELIMIT_MAX=300
RATELIMIT_WINDOW=5s

# Avatar Compression
AVATAR_SIZE=184
AVATAR_QUALITY=85

# Database Pool Tuning (Optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m

# Logging Level (info, debug, warn, error)
LOG_LEVEL=info

# Legacy Mode (đọc database phiên bản cũ: users + user_steam_profiles + user_discord_profiles)
LEGACY_MODE=false
